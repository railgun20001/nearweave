{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NearWeave",
  "version": "0.4.0",
  "identifier": "io.github.railgun20001.nearweave",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NearWeave · 附近设备互传",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "railgun20001",
    "homepage": "https://github.com/railgun20001/nearweave",
    "copyright": "Copyright © 2026 railgun20001",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "附近设备互传",
    "longDescription": "NearWeave 使用加密局域网或点对点蓝牙连接，在受信任的附近设备之间共享文件、授权目录和剪贴板内容。",
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyNzA0NjcyRkMyOEMyMzAKUldRd3dpajhja1p3UWxzYm9IcjZpdmtRQmtCcVVETmJXNlVlbElOOVFMU0lQYjNmZ2NMWTl5RkcK",
      "endpoints": [
        "https://gitee.com/railgun20001/nearweave-updates/raw/main/latest.json",
        "https://github.com/railgun20001/nearweave/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
